{
  "name": "sofiya-ai",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "pnpm build:shared && pnpm -r lint",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r test",
    "check": "pnpm typecheck && pnpm -r lint && pnpm -r test && pnpm build",
    "build:shared": "pnpm --filter @sofiya/shared build"
  }
}
