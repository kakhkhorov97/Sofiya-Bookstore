# Copy to .env.local for local development.
# Server-side base URL of the NestJS API.
# In Docker it is also a build argument: /api forwarding is fixed at build time.
API_URL=http://localhost:8080/api
APP_VERSION=dev
# Production only: same value as the API's PROXY_SECRET, and how many proxy
# hops to count back in X-Forwarded-For (1 on Cloud Run alone).
PROXY_SECRET=
CLIENT_IP_HOPS=1
