# Copy to .env for local development. Real values live in Google Secret Manager.
NODE_ENV=development
PORT=8080
WEB_ORIGINS=http://localhost:3000
APP_VERSION=dev
# Local: postgresql://localhost:5432/sofiya_dev  ·  Production: Neon pooled URL (?sslmode=require)
DATABASE_URL=postgresql://localhost:5432/sofiya_dev
# Milestone 5: Gemini API key (or use Vertex AI with the Cloud Run service account)
GEMINI_API_KEY=
# Signs session cookies. Generate with: openssl rand -base64 48
AUTH_SECRET=
AUTH_RATE_LIMIT=10
BCRYPT_ROUNDS=12
# Optional: override the Gemini models.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
AI_RATE_LIMIT=8
AI_DAILY_CAP=200
AI_MIN_SIMILARITY=0.6
# Proxies allowed to set X-Forwarded-For: "loopback" locally, a hop count on Cloud Run.
TRUST_PROXY=loopback
AI_SIMILARITY_WINDOW=0.06
# Where covers are stored: "local" (UPLOADS_DIR, relative to apps/api) or
# "gcs" (GCS_BUCKET). Production must use gcs: Cloud Run's disk is temporary.
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
GCS_BUCKET=
# Shared with the web app so the API can trust the visitor IP it passes on
# (rate limits). Required in production; leave empty locally.
PROXY_SECRET=
# Toss Payments (card and easy pay). Get test keys (test_ck_… / test_sk_…) from
# the Toss Payments developer centre; card payments stay off until both are set.
# The client key is public; never commit the secret key.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# "fake" simulates card payments with no Toss account (local demos only;
# it overrides the keys above, so remove it once you add them).
PAYMENTS_PROVIDER=
# Currencies cards may be charged in (Toss needs a contract per currency).
CARD_CURRENCIES=KRW
# Unpaid card orders are cancelled after this many minutes.
CARD_PAYMENT_TIMEOUT_MINUTES=30
# Shown to customers who choose bank transfer.
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
# Email: "log" prints emails in this terminal (default locally), "resend"
# sends through resend.com, "off" disables email (default in production).
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=Sofiya <onboarding@resend.dev>
# Website address used in email links (defaults to the first WEB_ORIGINS entry).
WEB_URL=
PASSWORD_RESET_MINUTES=30
# Optional: share rate limits and the daily AI cap between API instances.
# redis://localhost:6379 locally, rediss://… for Upstash.
REDIS_URL=
