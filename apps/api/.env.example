# Copy to .env for local development. Real values live in Google Secret Manager.
NODE_ENV=development
PORT=8080
WEB_ORIGINS=http://localhost:3000
APP_VERSION=dev
# Local: postgresql://localhost:5432/sofiya_dev  ·  Production: Neon pooled URL (?sslmode=require)
DATABASE_URL=postgresql://localhost:5432/sofiya_dev
# Milestone 5: Gemini API key (or use Vertex AI with the Cloud Run service account)
GEMINI_API_KEY=
# Signs session cookies. Generate with: openssl rand -base64 48
AUTH_SECRET=
AUTH_RATE_LIMIT=10
BCRYPT_ROUNDS=12
# Optional: override the Gemini models.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
AI_RATE_LIMIT=8
AI_DAILY_CAP=200
AI_MIN_SIMILARITY=0.6
# Proxies allowed to set X-Forwarded-For: "loopback" locally, a hop count on Cloud Run.
TRUST_PROXY=loopback
AI_SIMILARITY_WINDOW=0.06
