# Copy to .env for local development. Real values live in Google Secret Manager.
NODE_ENV=development
PORT=8080
WEB_ORIGINS=http://localhost:3000
APP_VERSION=dev
# Milestone 1: Neon Postgres connection string (pooled), e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
# Milestone 5: Gemini API key (or use Vertex AI with the Cloud Run service account)
GEMINI_API_KEY=
