# Copy to .env for local development. Real values live in Google Secret Manager.
NODE_ENV=development
PORT=8080
WEB_ORIGINS=http://localhost:3000
APP_VERSION=dev
# Local: postgresql://localhost:5432/sofiya_dev  ·  Production: Neon pooled URL (?sslmode=require)
DATABASE_URL=postgresql://localhost:5432/sofiya_dev
# Milestone 5: Gemini API key (or use Vertex AI with the Cloud Run service account)
GEMINI_API_KEY=
# Signs session cookies. Generate with: openssl rand -base64 48
AUTH_SECRET=
AUTH_RATE_LIMIT=10
BCRYPT_ROUNDS=12
